<Window x:Class="CrazyZoo.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crazy Zoo" Height="720" Width="980"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Crazy Zoo" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Lisa loom" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,8"/>

            <TextBlock Text="Looma tüüp"/>
            <ComboBox x:Name="AnimalTypeComboBox" Height="28" Margin="0,4,0,8"/>

            <TextBlock Text="Nimi"/>
            <TextBox x:Name="NameTextBox" Height="28" Margin="0,4,0,8"/>

            <TextBlock Text="Vanus"/>
            <TextBox x:Name="AgeTextBox" Height="28" Margin="0,4,0,10"/>

            <WrapPanel Margin="0,0,0,10">
                <Button Content="Lisa" Width="90" Height="30" Click="AddButton_Click"/>
                <Button Content="Eemalda" Width="90" Height="30" Margin="8,0,0,0" Click="RemoveButton_Click"/>
            </WrapPanel>

            <TextBlock x:Name="ValidationTextBlock" Foreground="DarkRed" TextWrapping="Wrap" MinHeight="42"/>

            <TextBlock Text="Loomad" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,8"/>
            <ListBox x:Name="AnimalsListBox" Height="330" SelectionChanged="AnimalsListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="3">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TypeName}" Foreground="DimGray"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Valitud looma detailid" FontSize="20" FontWeight="Bold"/>

            <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Padding="12" Margin="0,12,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Tüüp:"/>
                    <TextBlock x:Name="TypeValueTextBlock" Grid.Column="1" FontWeight="Bold"/>
                    <TextBlock Text="Nimi:" Grid.Row="1"/>
                    <TextBlock x:Name="NameValueTextBlock" Grid.Row="1" Grid.Column="1"/>
                    <TextBlock Text="Vanus:" Grid.Row="2"/>
                    <TextBlock x:Name="AgeValueTextBlock" Grid.Row="2" Grid.Column="1"/>
                    <TextBlock Text="Lemmiktoit:" Grid.Row="3"/>
                    <TextBlock x:Name="FoodValueTextBlock" Grid.Row="3" Grid.Column="1"/>
                    <TextBlock Text="Võimed:" Grid.Row="4"/>
                    <TextBlock x:Name="AbilitiesValueTextBlock" Grid.Row="4" Grid.Column="1"/>
                    <TextBlock Text="Õnnelikkus:" Grid.Row="5"/>
                    <TextBlock x:Name="HappinessValueTextBlock" Grid.Row="5" Grid.Column="1"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <TextBlock Text="Energia" FontWeight="SemiBold"/>
                <ProgressBar x:Name="EnergyProgressBar" Minimum="0" Maximum="100" Height="22"/>
                <TextBlock x:Name="EnergyValueTextBlock" HorizontalAlignment="Center"/>
            </StackPanel>

            <WrapPanel Grid.Row="3" Margin="0,0,0,10">
                <Button Content="Tavaline tegevus" Width="125" Height="32" Click="ActButton_Click"/>
                <Button Content="CrazyAction" Width="115" Height="32" Margin="8,0,0,0" Click="CrazyButton_Click"/>
                <Button Content="Söö" Width="80" Height="32" Margin="8,0,0,0" Click="EatButton_Click"/>
            </WrapPanel>

            <WrapPanel Grid.Row="4" Margin="0,0,0,10">
                <Button x:Name="SwimButton" Content="Uju" Width="80" Height="30" Click="SwimButton_Click"/>
                <Button x:Name="ClimbButton" Content="Roni" Width="80" Height="30" Margin="8,0,0,0" Click="ClimbButton_Click"/>
                <Button x:Name="FlyButton" Content="Lenda" Width="80" Height="30" Margin="8,0,0,0" Click="FlyButton_Click"/>
            </WrapPanel>

            <GroupBox Grid.Row="5" Header="Tegevuste logi">
                <ListBox x:Name="LogListBox"/>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
