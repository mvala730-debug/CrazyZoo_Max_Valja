<Window x:Class="CrazyZoo.WpfApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Crazy Zoo Vol. 3" Height="720" Width="1050" WindowStartupLocation="CenterScreen"><Grid Margin="15"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Crazy Zoo Vol. 3" FontSize="23" FontWeight="Bold"/><TextBlock Text="Looma tüüp" Margin="0,12,0,3"/><ComboBox x:Name="TypeBox"/><TextBlock Text="Nimi" Margin="0,8,0,3"/><TextBox x:Name="NameBox"/><TextBlock Text="Vanus" Margin="0,8,0,3"/><TextBox x:Name="AgeBox"/><Button Content="Lisa loom" Click="Add_Click" Margin="0,9,0,8"/><TextBlock x:Name="StatusText" Foreground="DarkRed" TextWrapping="Wrap" MinHeight="35"/><TextBlock Text="Vali arvutuseks vähemalt 3 looma" FontWeight="Bold" Margin="0,8,0,4"/><ListBox x:Name="AnimalsList" SelectionMode="Extended" Height="360"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3"><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock Text="{Binding TypeName}" Foreground="DimGray"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel><Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="CPU-arvutused" FontSize="20" FontWeight="Bold"/><Grid Grid.Row="1" Margin="0,12,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="220"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Töömaht:" VerticalAlignment="Center"/><ComboBox x:Name="WorkloadBox" Grid.Column="1"/><TextBlock Text="Iteratsioonid:" Grid.Column="2" VerticalAlignment="Center"/><TextBox x:Name="IterationsBox" Grid.Column="3" Text="3000000"/></Grid><WrapPanel Grid.Row="2" Margin="0,0,0,10"><Button Content="Järjestikune" Click="Sequential_Click" Width="120" Height="32"/><Button Content="Paralleelne" Click="Parallel_Click" Width="120" Height="32" Margin="8,0,0,0"/><Button Content="Tühista" Click="Cancel_Click" Width="90" Height="32" Margin="8,0,0,0"/><ProgressBar x:Name="BusyBar" IsIndeterminate="True" Visibility="Collapsed" Width="130" Height="20" Margin="12,6,0,0"/></WrapPanel><TextBlock x:Name="TotalText" Grid.Row="3" FontWeight="Bold" Margin="0,0,0,8"/><DataGrid x:Name="ReportGrid" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Objekt" Binding="{Binding AnimalName}" Width="*"/><DataGridTextColumn Header="Olek" Binding="{Binding State}" Width="120"/><DataGridTextColumn Header="Tulemus / viga" Binding="{Binding Message}" Width="2*"/><DataGridTextColumn Header="Kestus ms" Binding="{Binding DurationMs}" Width="110"/></DataGrid.Columns></DataGrid></Grid></Grid></Window>