<Window x:Class="CrazyZoo.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crazy Zoo Vol. 2"
        Height="720"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Crazy Zoo Vol. 2"
                       FontSize="22"
                       FontWeight="Bold"/>

            <TextBlock Text="Looma tüüp"
                       Margin="0,15,0,4"/>

            <ComboBox ItemsSource="{Binding AnimalTypes}"
                      SelectedItem="{Binding SelectedType}"
                      Height="28"/>

            <TextBlock Text="Nimi"
                       Margin="0,8,0,4"/>

            <TextBox Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}"
                     Height="28"/>

            <TextBlock Text="Vanus"
                       Margin="0,8,0,4"/>

            <TextBox Text="{Binding AgeInput, UpdateSourceTrigger=PropertyChanged}"
                     Height="28"/>

            <Button Content="Lisa"
                    Command="{Binding AddCommand}"
                    Height="30"
                    Margin="0,10,0,0"/>

            <TextBlock Text="{Binding StatusText}"
                       Foreground="DarkRed"
                       TextWrapping="Wrap"
                       MinHeight="40"
                       Margin="0,8,0,0"/>

            <TextBlock Text="Otsing"
                       Margin="0,8,0,4"/>

            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Height="28"/>

            <TextBlock Text="Sortimine"
                       Margin="0,8,0,4"/>

            <ComboBox ItemsSource="{Binding SortOptions}"
                      SelectedItem="{Binding SelectedSort}"
                      Height="28"/>

            <ListBox ItemsSource="{Binding VisibleAnimals}"
                     SelectedItem="{Binding SelectedAnimal}"
                     Height="280"
                     Margin="0,10,0,0">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="3">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="Bold"/>

                            <TextBlock Foreground="DimGray">
                                <Run Text="{Binding TypeName, Mode=OneWay}"/>
                                <Run Text=" | vanus: "/>
                                <Run Text="{Binding Age, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="130"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Padding="12">

                <StackPanel>
                    <TextBlock Text="Valitud loom"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <TextBlock Margin="0,8,0,0">
                        <Run Text="Nimi: "/>
                        <Run Text="{Binding SelectedAnimal.Name, Mode=OneWay}"/>
                    </TextBlock>

                    <TextBlock>
                        <Run Text="Tüüp: "/>
                        <Run Text="{Binding SelectedAnimal.TypeName, Mode=OneWay}"/>
                    </TextBlock>

                    <TextBlock>
                        <Run Text="Energia: "/>
                        <Run Text="{Binding SelectedAnimal.Energy, Mode=OneWay}"/>
                    </TextBlock>

                    <TextBlock>
                        <Run Text="Õnnelikkus: "/>
                        <Run Text="{Binding SelectedAnimal.Happiness, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <WrapPanel Grid.Row="1"
                       Margin="0,10,0,10">

                <Button Content="Tavaline tegevus"
                        Command="{Binding ActCommand}"
                        Width="125"
                        Height="31"/>

                <Button Content="CrazyAction"
                        Command="{Binding CrazyActionCommand}"
                        Width="115"
                        Height="31"
                        Margin="8,0,0,0"/>

                <Button Content="Söö"
                        Command="{Binding EatCommand}"
                        Width="80"
                        Height="31"
                        Margin="8,0,0,0"/>

                <Button Content="Eemalda"
                        Command="{Binding RemoveCommand}"
                        Width="90"
                        Height="31"
                        Margin="8,0,0,0"/>
            </WrapPanel>

            <TextBlock Grid.Row="2"
                       Text="Kokkuvõte tüübi järgi"
                       FontSize="17"
                       FontWeight="Bold"/>

            <ListBox Grid.Row="3"
                     ItemsSource="{Binding GroupSummary}"
                     Margin="0,6,0,10"/>

            <GroupBox Grid.Row="4"
                      Header="Logi">
                <ListBox ItemsSource="{Binding Log}"/>
            </GroupBox>
        </Grid>
    </Grid>
</Window>